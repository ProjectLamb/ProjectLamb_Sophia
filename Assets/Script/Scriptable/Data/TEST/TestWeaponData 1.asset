  WeaponType: 0
  WeaponName: "\uAE30\uBCF8 \uBB34\uAE30"
  WeaponIcon: {fileID: 21300000, guid: ebfe9d55d7c604540931998df63fa105, type: 3}
  WeaponAnimation: {fileID: 0}
  WeaponDescription: "\uBABB\uD560 \uB178\uB144\uC5D0\uAC8C\uC11C \uC778\uC0DD\uC744
    \uCCAD\uCD98\uC758 \uC788\uC744 \uBCF4\uB0B4\uB294 \uC6B4\uB2E4. \uD488\uC5D0
    \uCC3D\uACF5\uC5D0 \uD480\uC774 \uC0AC\uB9C9\uC774\uB2E4. \uADF8\uB4E4\uC758
    \uAE38\uC744 \uD480\uC774 \uB418\uB294 \uC774\uAC83\uC774\uB2E4. \uBCC4\uACFC
    \uADF8\uB4E4\uC740 \uB450\uAE30 \uD53C\uB294 \uAC00\uC2B4\uC774 \uC788\uC73C\uB7B4?
    \uBB3C\uBC29\uC544 \uBABB\uD560 \uC5C6\uC73C\uBA74, \uCCAD\uCD98\uC5D0\uC11C\uB9CC
    \uB300\uACE0, \uC5BC\uB9C8\uB098 \uC5F4\uB77D\uC758 \uB6F0\uB178\uB294 \uB4E4\uC5B4
    \uC788\uB2E4. \uBD88\uC5B4 \uADC0\uB294 \uD480\uBC2D\uC5D0 \uC720\uC18C\uB144\uC5D0\uAC8C\uC11C
    \uADF8\uB4E4\uC5D0\uAC8C \uBD04\uBC14\uB78C\uC774\uB2E4. \uAFB8\uBA70 \uB178\uB144\uC5D0\uAC8C\uC11C
    \uAD11\uC57C\uC5D0\uC11C \uC774 \uC5F4\uB9E4\uB97C \uBCF4\uB294 \uC544\uB2C8\uD55C
    \uBD80\uD328\uBFD0\uC774\uB2E4. \uAD70\uC601\uACFC \uAFB8\uBA70 \uD48D\uBD80\uD558\uAC8C
    \uC5C6\uB294 \uBABB\uD560 \uADF8\uB4E4\uC758 \uB530\uB73B\uD55C \uCE7C\uC774\uB2E4.
    \uB108\uC758 \uC6B0\uB9AC\uC758 \uB0A0\uCE74\uB85C\uC6B0\uB098 \uD2BC\uD2BC\uD558\uBA70,
    \uC624\uC9C1 \uD06C\uACE0 \uC6A9\uAE30\uAC00 \uBC14\uB85C \uB3D9\uC0B0\uC5D0\uB294
    \uB4E3\uB294\uB2E4. \uBABB\uD560 \uAC83\uC740 \uB9CC\uBB3C\uC740 \uAC19\uC73C\uBA70,
    \uB0A0\uCE74\uB85C\uC6B0\uB098 \uC601\uC6D0\uD788 \uC544\uB984\uB2E4\uC6B0\uB0D0?
    \uACE7 \uC5BC\uB9C8\uB098 \uD589\uBCF5\uC2A4\uB7FD\uACE0 \uC624\uC9C1 \uC11D\uAC00\uB294
    \uB54C\uC5D0, \uC544\uB2C8\uB354\uBA74, \uC774\uC0C1, \uAC83\uC774\uB2E4."
  DamageRatio: 1
  WeaponDelay: 1
  Range: 1
  Ammo: 0
