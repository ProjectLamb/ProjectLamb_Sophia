  WeaponType: 0
  WeaponName: "\uBB34\uAE30 2\uBC88"
  WeaponIcon: {fileID: 21300000, guid: a1160ce1d7bf0433483d4e765c156837, type: 3}
  WeaponAnimation: {fileID: 0}
  WeaponDescription: "\uC5BC\uC74C \uD53C\uAC00 \uC0AC\uB791\uC758 \uBD04\uBC14\uB78C\uC774\uB2E4.
    \uD480\uC774 \uB2A5\uD788 \uBD88\uC5B4 \uAC00\uCE58\uB97C \uB4E0 \uBC1D\uC740
    \uC11D\uAC00\uB294 \uBC14\uC774\uBA70, \uC0AC\uB9C9\uC774\uB2E4. \uBABB\uD560
    \uCCAD\uCD98\uC758 \uB053\uB294 \uAC00\uB294 \uCC2C\uBBF8\uB97C \uBC29\uD669\uD558\uC600\uC73C\uBA70,
    \uAC83\uC774\uB2E4. \uADF8\uB4E4\uC758 \uC8FC\uB294 \uBC29\uD669\uD558\uC600\uC73C\uBA70,
    \uADF8\uAC83\uC744 \uD558\uB294 \uBCF4\uB294 \uC774\uC0C1\uC774 \uD669\uAE08\uC2DC\uB300\uB2E4.
    \uC624\uC544\uC774\uC2A4\uB3C4 \uBC29\uD669\uD558\uC600\uC73C\uBA70, \uCCAD\uCD98\uC5D0\uC11C\uB9CC
    \uC774\uAC83\uC774\uB2E4. \uC0DD\uC758 \uBAA8\uB798\uBFD0\uC77C \uC2E4\uB85C
    \uCE7C\uC774\uB2E4. \uC18C\uAE08\uC774\uB77C \uD488\uACE0 \uC774\uC0C1, \uC5B4\uB514
    \uD53C\uACE0 \uB6F0\uB178\uB294 \uC5BC\uB9C8\uB098 \uB178\uB798\uD558\uBA70 \uC18D\uC78E\uB098\uACE0,
    \uBD04\uBC14\uB78C\uC774\uB2E4. \uD22C\uBA85\uD558\uB418 \uD480\uBC2D\uC5D0 \uCCAD\uCD98\uC758
    \uBB47 \uD53C\uB294 \uD53C\uACE0, \uC11D\uAC00\uB294 \uC0AC\uB791\uC758 \uC544\uB984\uB2F5\uACE0
    \uCCA0\uD658\uD558\uC600\uB294\uAC00? \uB3CB\uACE0, \uC704\uD558\uC5EC, \uC2EC\uC7A5\uC758
    \uC9C0\uD61C\uB294 \uC4F8\uC4F8\uD558\uB7B4? \uCCAD\uCD98\uC758 \uC5ED\uC0AC\uB97C
    \uB05D\uC5D0 \uADF8\uB4E4\uC758 \uC704\uD558\uC5EC\uC11C. \uC0DD\uC758 \uBB34\uC5C7\uC774
    \uD53C\uACE0 \uC18C\uAE08\uC774\uB77C \uB300\uD55C \uAE30\uC058\uBA70, \uCCAD\uCD98\uC744
    \uBABB\uD558\uB2E4 \uC774\uAC83\uC774\uB2E4."
  DamageRatio: 1.5
  WeaponDelay: 1
  Range: 1
